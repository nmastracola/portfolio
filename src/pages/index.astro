---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';
---

<BaseLayout title="Nicholas Mastracola" description="Developer. Writer. Homelab enthusiast.">
  <section class="hero container">
    <div class="hero-text">
      <h1>Nicholas Mastracola</h1>
      <p class="tagline">Software Developer & Systems Specialist</p>
      <div class="cta-row">
        <a class="button" href="/cv">View CV</a>
      </div>
    </div>
    <div class="hero-photo" aria-hidden="true"><Image class="hero-photo" src={headshot} alt="Nicholas Mastracola" width={400} height={400} densities={[1, 2]}/></div>
  </section>

  <section class="container">
    <h2>Selected work</h2>
    <p class="placeholder-note">
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding-block: var(--space-5);
    align-items: center;
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 3fr 2fr;
    }
  }

  .tagline {
    font-size: 1.25rem;
    color: var(--color-ink-muted);
    max-width: 32rem;
  }

  .cta-row {
    margin-top: var(--space-3);
  }

  .hero-photo {
    aspect-ratio: 1 / 1;
  }

  .hero-photo img {
    border-radius: var(--radius-md);
  }

  .placeholder-note {
    color: var(--color-ink-muted);
    font-style: italic;
  }
</style>
