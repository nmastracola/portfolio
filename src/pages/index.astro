---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Nicholas Mastracola" description="Developer. Writer. Homelab enthusiast.">
  <section class="hero container">
    <div class="hero-text">
      <!--
        TODO: this is the one line that has to do real work — decide
        what the site is asserting about you before filling this in.
        "Developer" alone reads differently than "developer who also
        writes about mythology and Destiny 2 lore." Pick on purpose.
      -->
      <h1>Nicholas Mastracola</h1>
      <p class="tagline">Replace with your one-line positioning statement.</p>
      <div class="cta-row">
        <a class="button" href="/cv">View CV</a>
      </div>
    </div>
    <!--
      TODO: headshot goes here. Decide crop (square vs. circle) and
      whether the landing page wants the same formal crop as the CV
      page or something looser — see earlier discussion on tone.
    -->
    <div class="hero-photo" aria-hidden="true"></div>
  </section>

  <section class="container">
    <h2>Selected work</h2>
    <p class="placeholder-note">
      Populate once you've decided what belongs here — dev projects,
      homelab writeups, or both. Keep this section deliberately empty
      rather than filling it with placeholder cards; an empty section
      with a clear label is more honest than fake content.
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding-block: var(--space-5);
    align-items: center;
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 3fr 2fr;
    }
  }

  .tagline {
    font-size: 1.25rem;
    color: var(--color-ink-muted);
    max-width: 32rem;
  }

  .cta-row {
    margin-top: var(--space-3);
  }

  .hero-photo {
    aspect-ratio: 1 / 1;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .placeholder-note {
    color: var(--color-ink-muted);
    font-style: italic;
  }
</style>
